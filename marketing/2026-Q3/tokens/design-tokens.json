{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "ADScale design tokens — extraídos do design system (design.md + app/src/app/globals.css). Importar no Figma/Tokens Studio pra replicar no Canva.",
  "color": {
    "light": {
      "deep-bg": { "value": "#fafafa", "type": "color", "description": "Background de páginas claras" },
      "surface-base": { "value": "#ffffff", "type": "color", "description": "Cards, fundo primário" },
      "surface-raised": { "value": "#f5f5f5", "type": "color", "description": "Fundo secundário, badges" },
      "text-primary": { "value": "#0a0a0a", "type": "color", "description": "Texto principal" },
      "text-secondary": { "value": "#444444", "type": "color", "description": "Texto de apoio" },
      "text-muted": { "value": "#525252", "type": "color", "description": "Legendas, fonte pequena" },
      "accent-green": { "value": "#00b34a", "type": "color", "description": "CTA primário, badge destaque" },
      "accent-green-bright": { "value": "#00e85e", "type": "color", "description": "Hover, highlight, número de impacto" },
      "accent-green-dark": { "value": "#007a33", "type": "color", "description": "Hover de hover" },
      "accent-rose": { "value": "#d43d5c", "type": "color", "description": "Erro, 'pare de fazer X'" },
      "accent-amber": { "value": "#c7920a", "type": "color", "description": "Aviso, 'atenção'" },
      "ink": { "value": "#0a0a0a", "type": "color", "description": "Botão primário sólido" }
    },
    "dark": {
      "deep-bg": { "value": "#0a0a0a", "type": "color", "description": "Background dark" },
      "surface-base": { "value": "#111111", "type": "color", "description": "Cards dark" },
      "surface-raised": { "value": "#1a1a1a", "type": "color", "description": "Fundo secundário dark" },
      "text-primary": { "value": "#ffffff", "type": "color", "description": "Texto principal dark" },
      "text-secondary": { "value": "#888888", "type": "color", "description": "Texto de apoio dark" },
      "accent-green": { "value": "#00e85e", "type": "color", "description": "Accent dark" },
      "accent-green-bright": { "value": "#3fff80", "type": "color", "description": "Highlight extremo dark" }
    }
  },
  "typography": {
    "display": {
      "fontFamily": "Press Start 2P",
      "fontSize": "clamp(3rem, 8vw, 7rem)",
      "fontWeight": 400,
      "lineHeight": 1.1,
      "letterSpacing": "normal",
      "description": "Sparingly: hero stat, CTA primário, número grande"
    },
    "headline": {
      "fontFamily": "Inter",
      "fontSize": "clamp(2rem, 5vw, 4rem)",
      "fontWeight": 800,
      "lineHeight": 1.1,
      "letterSpacing": "-0.02em",
      "description": "Título de carrossel, headline de Reels"
    },
    "title": {
      "fontFamily": "Inter",
      "fontSize": "1.125rem",
      "fontWeight": 600,
      "lineHeight": 1.3,
      "description": "Subtítulo, chamada secundária"
    },
    "body": {
      "fontFamily": "Inter",
      "fontSize": "0.9375rem",
      "fontWeight": 400,
      "lineHeight": 1.8,
      "description": "Texto corrido, parágrafo de explicação"
    },
    "label": {
      "fontFamily": "Space Mono",
      "fontSize": "0.625rem",
      "fontWeight": 500,
      "lineHeight": 1.4,
      "letterSpacing": "0.2em",
      "textTransform": "uppercase",
      "description": "Badge, label de seção, número de slide"
    }
  },
  "radius": {
    "sm": { "value": "2px", "description": "Tags, badges pequenas" },
    "md": { "value": "4px", "description": "Botões, inputs (default)" },
    "lg": { "value": "8px", "description": "Cards, subseções" },
    "xl": { "value": "12px", "description": "Cards grandes, capa de carrossel" },
    "full": { "value": "9999px", "description": "Pílulas, badges circulares, avatares" }
  },
  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" }
  }
}

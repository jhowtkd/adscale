        "src/server/repositories/landing-page.ts"
      ]
    },
    {
      "id": "persona_simulation",
      "reason": "Idem. Avaliada para remoção/ocultação na Fase 7.",
      "paths": [
        "src/server/ai/persona-simulator.ts",
        "src/app/api/creatives/[id]/persona-simulation",
        "src/server/repositories/persona-simulation.ts",
        "src/server/assistant/action-execution/handlers/quick-persona-simulate.ts"

        "/campaigns",
        "/campaigns/[id]",
        "src/app/api/campaigns"
      ]
    },
    {
      "id": "assistant",
      "kind": "primary_destination",
      "description": "Assistente: interface conversacional que cria e opera trabalhos criativos.",
      "entrypoints": [
        "/assistant",
        "src/app/api/assistant"
      ]
    },
    {
      "id": "quick_tool_create_post",
      "kind": "primary_destination",
      "description": "Quick Tools / Criar Post: atalho que inicia um trabalho criativo preconfigurado.",
      "entrypoints": [
        "/quick-tools/create-post",
        "src/app/api/creative-work"
      ]
    },
    {
      "id": "brand_training",
      "kind": "supporting_module",
      "description": "Brand Training: módulo independente por marca.",
      "entrypoints": [
        "/brand-kit",
        "src/app/api/client-profiles/[id]/training-status",
        "src/server/brand-training"
      ]
    },
    {
      "id": "templates",
      "kind": "accelerator",
      "description": "Templates: acelerador que materializa intenção dentro do fluxo canônico.",
      "entrypoints": [
        "/templates",
        "src/app/api/templates"
      ]
    }

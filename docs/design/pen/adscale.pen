                                                        {
                                                          "type": "frame",
                                                          "id": "nfUXR",
                                                          "name": "Incluir: - Usar o logotipo oficial 1996–",
                                                          "context": "input",
                                                          "clip": true,
                                                          "width": "fill_container",
                                                          "height": 30,
                                                          "fill": "#0f1112",
                                                          "cornerRadius": 8,

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/adscale?sslmode=disable"
TEST_DATABASE_URL="postgres://test:test@localhost:5433/adscale_test"

# Auth
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# OAuth (optional — enables Google/GitHub login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# OpenAI
OPENAI_API_KEY="sk-replace-me"
OPENAI_TEXT_MODEL="gpt-5.6-sol"
OPENAI_IMAGE_MODEL="gpt-image-2-2026-04-21"

# Optional Seedream layerization; omit to disable the Dono da plataforma action.
# ATLASCLOUD_API_KEY="replace-with-atlascloud-api-key"

# R2 Storage
R2_ACCOUNT_ID="replace-me"
R2_ACCESS_KEY_ID="replace-me"
R2_SECRET_ACCESS_KEY="replace-me"
R2_BUCKET="adscale"
R2_PUBLIC_BASE_URL="https://example.r2.dev"

# Optional one-off curated inspiration import source
SOURCE_DATABASE_URL=""
SOURCE_R2_ACCOUNT_ID=""
SOURCE_R2_ACCESS_KEY_ID=""
SOURCE_R2_SECRET_ACCESS_KEY=""
SOURCE_R2_BUCKET=""
CURATED_TARGET_WORKSPACE_ID=""

# Inngest
INNGEST_EVENT_KEY="local"
INNGEST_SIGNING_KEY="local"

# Email
RESEND_API_KEY="re_replace_me"
EMAIL_FROM="ADScale <onboarding@resend.dev>"

# Waitlist (marketing site → Resend Audiences)
RESEND_WAITLIST_SEGMENT_ID=""
MARKETING_ALLOWED_ORIGINS="http://localhost:5173"

# App
APP_URL="http://localhost:3000"
# Public marketing site — unauthenticated visits to / redirect here
MARKETING_URL="http://localhost:3000/hi"
# Upstream static landing (proxied at /hi via next.config rewrites)
MARKETING_UPSTREAM_URL="http://localhost:5173"

# E2E / TestSprite — disable API rate limits during parallel browser tests
# E2E_DISABLE_RATE_LIMIT=true

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
STRIPE_STARTER_PRICE_ID="price_replace_starter"
STRIPE_GROWTH_PRICE_ID="price_replace_growth"
STRIPE_SCALE_PRICE_ID="price_replace_scale"
STRIPE_SUCCESS_URL="http://localhost:3000/settings?tab=billing&checkout=success"
STRIPE_CANCEL_URL="http://localhost:3000/settings?tab=plans&checkout=cancel"

# Beta testers — comma-separated codes; each workspace redeems once (10 ads, no Stripe)
# BETA_ACCESS_CODES="ADSCALE-BETA-EXAMPLE1,ADSCALE-BETA-EXAMPLE2"

# Dev admin — comma-separated; skips email verification and credit debits for owner workspaces
# DEV_ADMIN_EMAIL="you@example.com"

# Image job routing (web fallback vs background worker)
# IMAGE_JOB_TARGET=web
# IMAGE_ROUTE_CONCURRENCY=1

SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Creative Work quality recovery rollout (temporary switch, removed after Gate 8)
# Steers NEW preparations only; running jobs follow the version frozen in their snapshot.
CREATIVE_WORK_QUALITY_RECOVERY_ENABLED="false"

# Brand Cortex rollout: only newly confirmed Peça única works read a published version.
BRAND_CORTEX_SINGLE_PIECE_ENABLED="false"

# Temporary server-only Studio presentation rollout (0 = control only).
STUDIO_PROGRESSIVE_ROLLOUT_PERCENT=0

# Task 10: Studio carousel NEW-creation rollout (0 hides only the new card;
# existing carousel works stay readable/retryable/exportable). The value never
# reaches the browser — the dashboard page derives a boolean from it.
STUDIO_CAROUSEL_ROLLOUT_PERCENT=0

# Task 7: Studio entry interview rollout (0 hides the interview UI;
# uses the same deterministic bucket as progressive Studio). The value never
# reaches the browser — the dashboard page derives a boolean from it.
STUDIO_ENTRY_INTERVIEW_ROLLOUT_PERCENT=0

# Traceability rollout (#397): frozen defaults (capture off). Staged
# execution follows docs/runbooks/diagnostics-traceability-rollout.md.
OBSERVABILITY_ENABLED="false"
OBSERVABILITY_LANGFUSE_ENABLED="false"
OBSERVABILITY_WORKSPACE_ALLOWLIST=""
OBSERVABILITY_CONTENT_MODE=metadata_only

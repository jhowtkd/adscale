{
  "name": "adscale-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-inngest.mjs",
    "dev:next": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build --webpack",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:ci": "node scripts/analyze-bundle.mjs",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --config config/vitest.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "test:db:teardown": "tsx scripts/teardown-test-db.ts",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "seed:testsprite": "tsx scripts/seed-testsprite.ts",
    "seed:stripe": "tsx scripts/seed-stripe-real.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@axe-core/react": "^4.11.3",
    "@base-ui/react": "^1.4.1",
    "@getzep/zep-cloud": "^3.22.0",
    "@neondatabase/serverless": "^1.1.0",
    "@next/bundle-analyzer": "^16.2.7",
    "@sentry/nextjs": "^10.53.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-query-devtools": "^5.100.1",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@upstash/redis": "^1.38.0",
    "agentation": "^3.0.2",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.38.0",
    "inngest": "^4.4.0",
    "jszip": "^3.10.0",
    "lucide-react": "^1.11.0",
    "next": "16.2.6",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.1",
    "sharp": "^0.33.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "^3.0.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "inngest-cli": "^1.18.0",
    "jsdom": "^29.0.2",
    "tsx": "^4.19.0",

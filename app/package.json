{
  "name": "adscale-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-inngest.mjs",
    "dev:next": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' next build --webpack",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "analyze:ci": "node scripts/analyze-bundle.mjs",
    "start": "next start",
    "start:prod": "node scripts/start-with-inngest-sync.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config config/vitest.config.ts --passWithNoTests",
    "test:e2e": "playwright test",
    "test:create-post-e2e": "playwright test tests/e2e/create-post.spec.ts",
    "test:guided-e2e": "node scripts/run-guided-e2e.mjs",
    "test:visual-release": "playwright test --config playwright.release.config.ts",
    "release-gate": "node scripts/run-release-gate.mjs",
    "goal-agent-release-gate": "node scripts/run-goal-agent-release-gate.mjs",
    "test:db:setup": "tsx scripts/setup-test-db.ts",
    "test:db:teardown": "tsx scripts/teardown-test-db.ts",
    "inngest:dev": "inngest-cli dev -u http://localhost:3000/api/inngest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate-with-retry.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "catalog:import-inspirations": "tsx scripts/import-curated-inspirations.ts",
    "seed:testsprite": "tsx scripts/seed-testsprite.ts",
    "seed:stripe": "tsx scripts/seed-stripe-real.ts",
    "preflight:stripe": "tsx scripts/preflight-stripe-billing.ts",
    "seed:dev-admin": "tsx scripts/seed-dev-admin.ts",
    "seed:goal-agent-e2e": "tsx scripts/seed-goal-agent-e2e.ts",
    "seed:goal-agent-pilot": "tsx scripts/seed-goal-agent-pilot.ts",
    "seed:create-post-e2e": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed-create-post-e2e.ts",
    "seed:commercial-brand-studies": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed-commercial-brand-studies.ts",
    "validate:commercial-brand-studies": "NODE_OPTIONS='--conditions=react-server' tsx scripts/package-commercial-brand-studies.ts --validate-only",
    "capture:commercial-brand-studies": "tsx scripts/capture-ui-screenshots.ts --commercial-studies",
    "seed:layer-editor-e2e": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed-layer-editor-e2e.ts",
    "seed:phase6-uat": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed-phase6-uat.ts",
    "seed:phase8-human": "NODE_OPTIONS='--conditions=react-server' tsx scripts/seed-phase8-human.ts",
    "snapshot:goal-agent-graduation": "tsx scripts/snapshot-goal-agent-graduation.ts",
    "validate:creative": "node scripts/check-creative-validation-evidence.mjs --stage final",
    "validate:creative:live": "npx tsx scripts/run-creative-validation.ts",
    "validate:brand-consistency": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-brand-consistency-validation.ts",
    "brand-cortex-pilot-package": "NODE_OPTIONS=--conditions=react-server tsx scripts/build-brand-cortex-pilot-package.ts",
    "brand-cortex-readiness-gate": "NODE_OPTIONS=--conditions=react-server tsx scripts/run-brand-cortex-readiness-gate.ts",
    "creative-release-gate": "node scripts/run-creative-release-gate.mjs",
    "creative-work-quality-recovery-gate": "tsx scripts/check-creative-work-quality-recovery-gate.ts ../.planning/validation/creative-work-quality-recovery-gate.json",
    "output-learning-release-gate": "node scripts/run-output-learning-release-gate.mjs",
    "score-calibration-evidence": "node scripts/check-score-calibration-evidence.mjs",
    "learning-impact-evidence": "node scripts/check-learning-impact-evidence.mjs",
    "quality-improvement-evidence": "node scripts/check-quality-improvement-evidence.mjs --evidence ../.planning/phases/132-targeted-creative-quality-improvements/132-EVIDENCE.template.json --skip-tests",
    "real-quality-release-evidence": "node scripts/check-real-quality-release-evidence.mjs --evidence ../.planning/phases/133-real-quality-release-gate/133-EVIDENCE.template.json --skip-tests",
    "operational-quality-release-evidence": "node scripts/check-operational-quality-release-evidence.mjs --evidence ../.planning/phases/137-operational-quality-release-gate/137-EVIDENCE.template.json --skip-tests",
    "olhar-release-evidence": "node scripts/check-olhar-release-evidence.mjs --evidence ../.planning/phases/142-cenbrap-calibration-and-release-evidence/142-EVIDENCE.template.json --skip-tests",
    "olhar-release-evidence:build": "npx tsx scripts/build-olhar-release-evidence.ts --calibration ../.planning/phases/142-cenbrap-calibration-and-release-evidence/142-CENBRAP-CALIBRATION.json --output ../.planning/phases/142-cenbrap-calibration-and-release-evidence/142-EVIDENCE.json",
    "real-quality-release-gate": "node scripts/run-real-quality-release-gate.mjs",
    "operational-quality-release-gate": "node scripts/run-operational-quality-release-gate.mjs",
    "v13-3-release-gate": "node scripts/run-v13-3-release-gate.mjs",
    "v13-7-release-gate": "node scripts/run-v13-7-release-gate.mjs",
    "v13-8-release-gate": "node scripts/run-v13-8-release-gate.mjs",
    "v13-9-release-gate": "node scripts/run-v13-9-release-gate.mjs",
    "seed:live-real-customer-corpus": "tsx scripts/seed-live-real-customer-corpus.ts",
    "refresh:v13-3-operational-evidence": "tsx scripts/refresh-v13-3-operational-evidence.ts",
    "sample-coverage-evidence": "npx tsx scripts/run-sample-coverage.ts --all-workspaces",
    "quality-trend-evidence": "npx tsx scripts/run-quality-trend.ts --all-workspaces",
    "convergence:check-destinations": "node scripts/check-primary-destinations.mjs",
    "convergence:check-frozen": "node scripts/check-frozen-modules.mjs",
    "convergence:check-planning": "node scripts/check-planning-consistency.mjs",
    "convergence:check-inventory": "node scripts/check-surface-inventory.mjs",
    "convergence:test": "node --test scripts/convergence-gates.test.mjs scripts/check-planning-consistency.test.mjs scripts/check-surface-inventory.test.mjs scripts/check-no-parallel-preview.test.mjs scripts/check-phase8-human-evidence.test.mjs",
    "convergence:baseline": "node scripts/capture-convergence-baseline.mjs",
    "convergence:phase8-check": "node scripts/check-phase8-human-evidence.mjs",
    "convergence:inventory": "node scripts/generate-surface-inventory.mjs",
    "convergence:gate": "node scripts/run-convergence-gate.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "ag-psd": "^15.1.0",
    "@base-ui/react": "^1.4.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/nextjs": "^10.53.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-query": "^5.100.1",
    "@tanstack/react-query-devtools": "^5.100.1",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@upstash/redis": "^1.38.0",
    "agentation": "^3.0.2",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.0.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "foglamp": "^0.7.1",
    "framer-motion": "^12.38.0",
    "inngest": "^4.4.0",
    "jszip": "^3.10.0",
    "lucide-react": "^1.11.0",
    "mem0ai": "^2.4.6",
    "next": "16.2.6",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "openai": "^6.34.0",
    "p-limit": "^7.3.0",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zod": "^3.0.0",
    "zustand": "^5.0.12",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.11.3",
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.7",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "inngest-cli": "^1.18.0",
    "jsdom": "^29.0.2",
    "typescript": "^5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "postcss": "8.5.10",
    "esbuild": "0.25.12"
  }
}
